---
// Home page: the IssyDBI.github.io template layout with Irfan's content.
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projectsByKind } from '../lib/projects';
import { me, skills, certifications, links } from '../data/site';
import '../styles/template.css';

const { stories, builds, soon } = await projectsByKind();
// Main grid: case studies plus any build marked `featured` (shown with a code link only).
const shown = [...stories, ...builds.filter((b) => b.data.featured)].sort((a, b) => a.data.order - b.data.order);
const formAction = me.contactEmail ? `https://formsubmit.co/${me.contactEmail}` : undefined;
const mail = me.contactEmail ? `mailto:${me.contactEmail}` : links.email;
---
<Base page="home">
  <!-- HEADER SECTION -->
  <header class="tpl-header tpl" slot="top">
    <div class="container">
      <h1>{me.fullName}</h1>
      <p>{me.role}</p>
      <div class="social-links">
        <a href={links.linkedin} target="_blank" rel="noopener" title="LinkedIn"><i class="fab fa-linkedin"></i></a>
        <a href={links.github} target="_blank" rel="noopener" title="GitHub"><i class="fab fa-github"></i></a>
        <a href={mail} title="Email"><i class="fas fa-envelope"></i></a>
      </div>
    </div>
  </header>

  <div class="tpl">
    <!-- ABOUT SECTION -->
    <section id="about" class="section">
      <div class="container">
        <h2>About Me</h2>
        <div class="about-content">
          <div class="profile-photo profile-initials" role="img" aria-label={me.fullName}>MI</div>
          <div class="about-text">
            {me.about.map((para) => <p>{para}</p>)}
          </div>
        </div>
      </div>
    </section>

    <!-- PROJECTS SECTION -->
    <section id="projects" class="section" style="padding-top:0">
      <div class="container">
        <h2>My Projects</h2>
        <div class="projects-grid">
          {shown.map((p) => <ProjectCard project={p} />)}
        </div>

        {soon.length > 0 && <>
          <h3 class="sub-title">In Progress</h3>
          <div class="projects-grid">
            {soon.map((p) => <ProjectCard project={p} />)}
          </div>
        </>}
      </div>
    </section>

    <!-- SKILLS SECTION -->
    <section id="skills" class="section" style="padding-top:0">
      <div class="container">
        <h2>Technical Skillset</h2>
        <div class="skills-table">
          {skills.map((g) => (
            <div class="skill-column">
              <div class="skill-header"><i class={g.fa}></i><h3>{g.title}</h3></div>
              <ul class="skill-list">{g.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CERTIFICATIONS (shown once there are some, in src/data/site.ts) -->
    {certifications.length > 0 && (
      <section id="certifications" class="section" style="padding-top:0">
        <div class="container">
          <h2>Certifications</h2>
          <div class="skills-table" style="grid-template-columns:1fr">
            <ul class="skill-list">
              {certifications.map((c) => (
                <li>{c.href ? <a href={c.href} target="_blank" rel="noopener">{c.name}</a> : c.name}<small>{c.issuer} · {c.year}</small></li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    <!-- CONTACT FORM SECTION -->
    <section id="contact" class="section" style="padding-top:0">
      <div class="container">
        <h2>Send me a message</h2>
        <form action={formAction} method="POST" class="contact-form">
          <p>Interested in working together or have questions about my work? I'd love to hear from you!</p>
          <input type="hidden" name="_subject" value="New message from your portfolio" />
          <div class="form-group"><label for="name">Name</label><input type="text" name="name" id="name" placeholder="Your name" required /></div>
          <div class="form-group"><label for="email">Email</label><input type="email" name="email" id="email" placeholder="Your email" required /></div>
          <div class="form-group"><label for="subject">Subject</label><input type="text" name="subject" id="subject" placeholder="Subject" required /></div>
          <div class="form-group"><label for="message">Message</label><textarea name="message" id="message" rows="6" placeholder="Your message" required></textarea></div>
          <button type="submit" class="btn" disabled={!formAction} title={formAction ? undefined : 'The form goes live once contactEmail is set in src/data/site.ts'}>Send Message</button>
        </form>
      </div>
    </section>
  </div>
</Base>
