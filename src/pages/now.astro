---
import Base from '../layouts/Base.astro';
import { now } from '../data/site';
const updated = new Date(now.updated).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Now" page="now">
  <main class="wrap">
    <div class="page-head">
      <div class="crumbs"><a href="/">Home</a> / Now</div>
      <h1>Now</h1>
      <p>What I'm doing this month. <span class="mono">last updated {updated}</span></p>
    </div>

    <div class="grid-2">
      <section>
        <div class="sec-head"><div><div class="kicker">Building</div><h2>Projects in progress</h2></div></div>
        <ul class="timeline">
          {now.building.map((n) => <li><span class="when">{n.when}</span><b>{n.href ? <a href={n.href}>{n.title}</a> : n.title}</b><p>{n.text}</p></li>)}
        </ul>
      </section>
      <section>
        <div class="sec-head"><div><div class="kicker">Next up</div><h2>On deck</h2></div></div>
        <ul class="timeline">
          {now.next.map((n) => <li><span class="when">{n.when}</span><b>{n.title}</b><p>{n.text}</p></li>)}
        </ul>
        <p class="mono" style="margin:20px 0 0">What's a now page? An idea from <a href="https://nownownow.com/about">nownownow.com</a>.</p>
      </section>
    </div>
  </main>
</Base>
