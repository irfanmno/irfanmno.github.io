---
// A photo/screenshot slot inside a story. Pass src for a real image, or leave it out for a placeholder.
interface Props { src?: string; alt?: string; label?: string; caption?: string; height?: number }
const { src, alt = '', label = 'image', caption, height = 240 } = Astro.props;
---
<figure class="fig">
  {src ? <img src={src} alt={alt} style="width:100%;border-radius:10px;display:block" loading="lazy" /> : <div class="ph" style={`height:${height}px`}>{label} (placeholder)</div>}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
